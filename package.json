{
  "name": "papertrade-liquidations",
  "version": "0.1.0",
  "description": "Unofficial live liquidation monitor and heatmap for Papertrade (papertrade.xyz), the 1000x synthetic perps exchange on HyperEVM: bust-price map, closest-to-bust table, liquidation feed, cascade stat and a JSON API.",
  "license": "Apache-2.0",
  "author": "nirholas",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/functions",
    "test": "vitest run",
    "record": "tsx scripts/record-fixtures.ts",
    "build:site": "esbuild site/app.ts --bundle --format=esm --minify --target=es2022 --sourcemap --outfile=site/public/app.js",
    "dev:site": "npm run build:site && cd site && wrangler pages dev --port 8794",
    "deploy:site": "npm run build:site && cd site && wrangler pages deploy"
  },
  "keywords": [
    "papertrade",
    "hyperliquid",
    "hyperevm",
    "liquidation",
    "heatmap",
    "perps",
    "defi",
    "cloudflare-pages",
    "liquidation-map",
    "liquidation-heatmap",
    "liquidation-tracker",
    "perpetuals",
    "bust-price",
    "typescript",
    "crypto",
    "web3",
    "trading-tools",
    "on-chain-analytics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/papertrade-liquidations.git"
  },
  "homepage": "https://papertrade-liquidations.pages.dev",
  "bugs": {
    "url": "https://github.com/nirholas/papertrade-liquidations/issues"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "papertrade-sdk": "file:../papertrade-sdk-0.1.0.tgz",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
